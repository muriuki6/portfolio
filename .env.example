# Copy this file to .env and fill in one of the two options below.
# For Vercel, add the same names in Project Settings → Environment Variables;
# .env itself is git-ignored and is not deployed.

# --- Option 1: Gmail (easiest) ---------------------------------------
# Turn on 2-Step Verification, then create an App Password:
# https://myaccount.google.com/apppasswords
# GMAIL_USER=nimmuriuki6@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Option 2: any SMTP provider -------------------------------------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-password

# Where messages should arrive (defaults to the Gmail/SMTP user above).
# CONTACT_TO=nimmuriuki6@gmail.com
# The From address shown in your inbox (defaults to the Gmail/SMTP user).
# CONTACT_FROM=nimmuriuki6@gmail.com
